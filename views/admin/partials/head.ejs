<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title %> - Admin | <%= settings ? settings.site_name : 'GlucoHarbor' %></title>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
<div class="admin-wrapper">
  <!-- Sidebar -->
  <nav class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-brand">
      <i class="fas fa-heartbeat"></i>
      <span>GlucoHarbor</span>
      <span class="sidebar-subtitle">Admin Panel</span>
    </div>
    <ul class="sidebar-nav">
      <li><a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
      <li class="nav-section">Content</li>
      <li><a href="/admin/articles" class="<%= currentPath.startsWith('/admin/articles') ? 'active' : '' %>"><i class="fas fa-newspaper"></i> Articles</a></li>
      <li><a href="/admin/categories" class="<%= currentPath.startsWith('/admin/categories') ? 'active' : '' %>"><i class="fas fa-folder"></i> Categories</a></li>
      <li><a href="/admin/pages" class="<%= currentPath.startsWith('/admin/pages') ? 'active' : '' %>"><i class="fas fa-file-alt"></i> Pages</a></li>
      <li class="nav-section">Shop</li>
      <li><a href="/admin/products" class="<%= currentPath.startsWith('/admin/products') ? 'active' : '' %>"><i class="fas fa-box-open"></i> Products</a></li>
      <li class="nav-section">Config</li>
      <li><a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>"><i class="fas fa-cog"></i> Settings</a></li>
      <li class="nav-divider"></li>
      <li><a href="/" target="_blank"><i class="fas fa-external-link-alt"></i> View Site</a></li>
      <li><a href="/admin/logout"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </nav>

  <!-- Main area -->
  <div class="admin-main">
    <!-- Top bar -->
    <header class="admin-topbar">
      <button class="sidebar-toggle" id="sidebarToggle"><i class="fas fa-bars"></i></button>
      <div class="topbar-right">
        <span class="admin-user-name"><i class="fas fa-user-circle"></i> <%= adminUser ? adminUser.username : '' %></span>
      </div>
    </header>
    <!-- Flash Message -->
    <% if (locals.flash) { %>
    <div class="alert alert-<%= locals.flash.type %> alert-dismissible fade show mx-3 mt-3" role="alert">
      <%= locals.flash.msg %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
    <% } %>
    <div class="admin-content">
