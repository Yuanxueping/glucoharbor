server {
    listen 80;
    listen [::]:80;
    server_name glucoharbor.com www.glucoharbor.com;

    # Redirect HTTP to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name glucoharbor.com www.glucoharbor.com;

    # SSL (Let's Encrypt via BaoTa)
    ssl_certificate     /etc/letsencrypt/live/glucoharbor.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/glucoharbor.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # Gzip
    gzip on;
    gzip_types text/css text/javascript application/json text/html;

    # Static files (served directly by Nginx for performance)
    location /uploads/ {
        alias /www/wwwroot/glucoharbor/public/uploads/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    location /css/ {
        alias /www/wwwroot/glucoharbor/public/css/;
        expires 7d;
    }
    location /js/ {
        alias /www/wwwroot/glucoharbor/public/js/;
        expires 7d;
    }

    # Proxy to Node.js app
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        client_max_body_size 20M;
    }
}
