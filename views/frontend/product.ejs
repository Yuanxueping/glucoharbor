<%- include('partials/head', {ogImage: product.image}) %>

<section class="section">
  <div class="container">
    <nav class="breadcrumb"><a href="/">Home</a> <i class="fas fa-chevron-right fa-xs"></i> <a href="/products">Products</a> <i class="fas fa-chevron-right fa-xs"></i> <span><%= product.name %></span></nav>

    <div class="product-detail">
      <div class="product-detail-img">
        <% if (product.image) { %>
        <img src="<%= product.image %>" alt="<%= product.name %>">
        <% } else { %>
        <div class="product-img-placeholder large"><i class="fas fa-box-open"></i></div>
        <% } %>
      </div>
      <div class="product-detail-info">
        <% if (product.category_name) { %><span class="product-category"><%= product.category_name %></span><% } %>
        <h1><%= product.name %></h1>
        <% if (product.short_desc) { %><p class="product-short-desc"><%= product.short_desc %></p><% } %>
        <div class="product-price-large">
          <% if (product.price) { %>
          <span class="price-big"><%= product.currency || '$' %><%= parseFloat(product.price).toFixed(2) %></span>
          <% if (product.original_price) { %>
          <span class="price-original-big"><%= product.currency || '$' %><%= parseFloat(product.original_price).toFixed(2) %></span>
          <% const discount = Math.round((1 - product.price/product.original_price)*100); %>
          <span class="discount-badge">-<%= discount %>%</span>
          <% } %>
          <% } %>
        </div>
        <% if (product.affiliate_url) { %>
        <a href="<%= product.affiliate_url %>" target="_blank" rel="noopener sponsored" class="btn-buy-large">
          <i class="fas fa-shopping-cart"></i> Buy Now
        </a>
        <% } %>
      </div>
    </div>

    <% if (product.description) { %>
    <div class="product-description">
      <h2>Product Description</h2>
      <%- product.description %>
    </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
