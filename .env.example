# App
NODE_ENV=production
PORT=3000
APP_URL=https://glucoharbor.com
SESSION_SECRET=change_this_to_a_random_string_at_least_32_chars

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=glucoharbor
DB_USER=root
DB_PASS=your_database_password

# JWT (for API access)
JWT_SECRET=change_this_to_another_random_string

# Admin default (will be overwritten after first login)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@glucoharbor.com
ADMIN_PASSWORD=Admin@123456

# Upload
UPLOAD_MAX_SIZE=10485760
