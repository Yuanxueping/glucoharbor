<%- include('../partials/head') %>

<div class="page-title">
  <h1>Settings</h1>
</div>

<% if (locals.flash) { %><div class="alert alert-<%= flash.type %> alert-dismissible fade show"><%= flash.msg %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>

<form method="post" action="/admin/settings">
  <!-- Nav Tabs -->
  <ul class="nav nav-tabs mb-3" id="settingsTabs">
    <li class="nav-item"><a class="nav-link active" href="#general" data-bs-toggle="tab">General</a></li>
    <li class="nav-item"><a class="nav-link" href="#ads" data-bs-toggle="tab">Advertising</a></li>
    <li class="nav-item"><a class="nav-link" href="#api" data-bs-toggle="tab">API / Import</a></li>
    <li class="nav-item"><a class="nav-link" href="#social" data-bs-toggle="tab">Social</a></li>
  </ul>

  <div class="tab-content">
    <!-- General -->
    <div class="tab-pane fade show active" id="general">
      <div class="card-box">
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label">Site Name</label><input type="text" name="site_name" class="form-control" value="<%= settings.site_name || '' %>"></div>
          <div class="col-md-6"><label class="form-label">Tagline</label><input type="text" name="site_tagline" class="form-control" value="<%= settings.site_tagline || '' %>"></div>
          <div class="col-12"><label class="form-label">Site Description (Default Meta)</label><textarea name="site_description" class="form-control" rows="2"><%= settings.site_description || '' %></textarea></div>
          <div class="col-md-6"><label class="form-label">Logo URL</label><input type="text" name="site_logo" class="form-control" value="<%= settings.site_logo || '' %>" placeholder="/uploads/logo.png"></div>
          <div class="col-md-6"><label class="form-label">Favicon URL</label><input type="text" name="site_favicon" class="form-control" value="<%= settings.site_favicon || '' %>" placeholder="/uploads/favicon.ico"></div>
          <div class="col-md-6"><label class="form-label">Contact Email</label><input type="email" name="contact_email" class="form-control" value="<%= settings.contact_email || '' %>"></div>
          <div class="col-md-6"><label class="form-label">Footer Text</label><input type="text" name="footer_text" class="form-control" value="<%= settings.footer_text || '' %>"></div>
          <div class="col-md-6"><label class="form-label">ICP Number (备案号)</label><input type="text" name="icp_number" class="form-control" value="<%= settings.icp_number || '' %>" placeholder="京ICP备xxxxxxxx号"></div>
          <div class="col-md-6"><label class="form-label">Google Analytics ID</label><input type="text" name="ga_tracking_id" class="form-control" value="<%= settings.ga_tracking_id || '' %>" placeholder="G-XXXXXXXXXX"></div>
          <div class="col-md-6"><label class="form-label">Articles Per Page</label><input type="number" name="articles_per_page" class="form-control" value="<%= settings.articles_per_page || 12 %>"></div>
          <div class="col-md-6"><label class="form-label">Products Per Page</label><input type="number" name="products_per_page" class="form-control" value="<%= settings.products_per_page || 12 %>"></div>
          <div class="col-12"><label class="form-label">Medical Disclaimer</label><textarea name="medical_disclaimer" class="form-control" rows="3"><%= settings.medical_disclaimer || '' %></textarea></div>
        </div>
      </div>
    </div>

    <!-- Advertising -->
    <div class="tab-pane fade" id="ads">
      <div class="card-box">
        <h3 class="card-box-title"><i class="fab fa-google"></i> Google AdSense</h3>
        <div class="row g-3">
          <div class="col-12">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="adsense_enabled" value="1" id="adsenseEnabled" <%= settings.adsense_enabled==='1'?'checked':'' %>>
              <label class="form-check-label" for="adsenseEnabled">Enable AdSense (auto ads)</label>
            </div>
          </div>
          <div class="col-12"><label class="form-label">Publisher ID</label><input type="text" name="adsense_publisher_id" class="form-control" value="<%= settings.adsense_publisher_id || '' %>" placeholder="ca-pub-xxxxxxxxxxxxxxxxx"></div>
        </div>
        <hr>
        <h3 class="card-box-title"><i class="fab fa-google"></i> Google AFS (Search Ads)</h3>
        <div class="row g-3">
          <div class="col-12">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="afs_enabled" value="1" id="afsEnabled" <%= settings.afs_enabled==='1'?'checked':'' %>>
              <label class="form-check-label" for="afsEnabled">Enable AFS</label>
            </div>
          </div>
          <div class="col-md-6"><label class="form-label">AFS Publisher ID</label><input type="text" name="afs_publisher_id" class="form-control" value="<%= settings.afs_publisher_id || '' %>"></div>
          <div class="col-md-6"><label class="form-label">AFS Channel</label><input type="text" name="afs_channel" class="form-control" value="<%= settings.afs_channel || '' %>"></div>
        </div>
        <hr>
        <h3 class="card-box-title">Custom Ad Code Slots</h3>
        <p class="text-muted small">Paste ad code (e.g. AdSense unit code). Leave blank to disable.</p>
        <div class="mb-3"><label class="form-label">Header Ad Code</label><textarea name="ad_header_code" class="form-control font-monospace" rows="3" placeholder="&lt;script&gt;...&lt;/script&gt;"><%= settings.ad_header_code || '' %></textarea></div>
        <div class="mb-3"><label class="form-label">Article Top Ad Code</label><textarea name="ad_article_top_code" class="form-control font-monospace" rows="3"><%= settings.ad_article_top_code || '' %></textarea></div>
        <div class="mb-3"><label class="form-label">Article Bottom Ad Code</label><textarea name="ad_article_bottom_code" class="form-control font-monospace" rows="3"><%= settings.ad_article_bottom_code || '' %></textarea></div>
        <div class="mb-3"><label class="form-label">Sidebar Ad Code</label><textarea name="ad_sidebar_code" class="form-control font-monospace" rows="3"><%= settings.ad_sidebar_code || '' %></textarea></div>
      </div>
    </div>

    <!-- API -->
    <div class="tab-pane fade" id="api">
      <div class="card-box">
        <h3 class="card-box-title"><i class="fas fa-plug"></i> API Token (for n8n / DeepSeek integration)</h3>
        <p>Use this token to authenticate requests to the article import API. Keep it secret.</p>
        <div class="input-group mb-3">
          <input type="text" id="apiTokenDisplay" class="form-control font-monospace" value="<%= settings.api_token || 'Not generated yet' %>" readonly>
          <button type="button" class="btn btn-warning" id="generateTokenBtn"><i class="fas fa-sync-alt"></i> Regenerate</button>
          <button type="button" class="btn btn-outline-secondary" onclick="navigator.clipboard.writeText(document.getElementById('apiTokenDisplay').value)"><i class="fas fa-copy"></i></button>
        </div>
        <div class="alert alert-info">
          <strong>API Endpoints:</strong><br>
          <code>POST /api/articles/import</code> — Import single article<br>
          <code>POST /api/articles/import-batch</code> — Import multiple articles<br>
          <code>GET /api/categories</code> — List categories<br>
          <br>
          <strong>Authentication:</strong> Add header <code>x-api-token: YOUR_TOKEN</code>
        </div>
        <div class="alert alert-secondary">
          <strong>n8n Workflow Example:</strong><br>
          1. Use HTTP Request node → POST to <code><%= appUrl %>/api/articles/import</code><br>
          2. Set header: <code>x-api-token</code><br>
          3. Body: JSON with title, content, excerpt, category_slug, featured_image<br>
          4. Connect to DeepSeek AI node to auto-generate content
        </div>
      </div>
    </div>

    <!-- Social -->
    <div class="tab-pane fade" id="social">
      <div class="card-box">
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label"><i class="fab fa-facebook"></i> Facebook URL</label><input type="url" name="social_facebook" class="form-control" value="<%= settings.social_facebook || '' %>"></div>
          <div class="col-md-6"><label class="form-label"><i class="fab fa-x-twitter"></i> X (Twitter) URL</label><input type="url" name="social_twitter" class="form-control" value="<%= settings.social_twitter || '' %>"></div>
          <div class="col-md-6"><label class="form-label"><i class="fab fa-instagram"></i> Instagram URL</label><input type="url" name="social_instagram" class="form-control" value="<%= settings.social_instagram || '' %>"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-3 text-end">
    <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-save"></i> Save All Settings</button>
  </div>
</form>

<script>
document.getElementById('generateTokenBtn').addEventListener('click', async function() {
  if (!confirm('Regenerate API token? Any existing n8n workflows using the old token will break.')) return;
  const r = await fetch('/admin/settings/generate-token', { method: 'POST' });
  const d = await r.json();
  if (d.success) {
    document.getElementById('apiTokenDisplay').value = d.token;
    alert('New API token generated. Update your n8n workflows.');
  }
});
</script>

<%- include('../partials/footer') %>
