<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title %> | <%= settings.site_name || 'GlucoHarbor' %></title>
  <meta name="description" content="<%= locals.metaDescription || settings.site_description || '' %>">
  <% if (locals.metaKeywords) { %><meta name="keywords" content="<%= locals.metaKeywords %>"><% } %>
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="<%= appUrl + currentPath %>">
  <meta property="og:title" content="<%= locals.title %>">
  <meta property="og:description" content="<%= locals.metaDescription || settings.site_description || '' %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= appUrl + currentPath %>">
  <% if (locals.ogImage) { %><meta property="og:image" content="<%= appUrl + locals.ogImage %>"><% } %>
  <% if (settings.site_favicon) { %><link rel="icon" href="<%= settings.site_favicon %>"><% } %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/frontend.css">
  <% if (settings.ga_tracking_id) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.ga_tracking_id %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','<%= settings.ga_tracking_id %>');</script>
  <% } %>
  <% if (settings.adsense_enabled === '1' && settings.adsense_publisher_id) { %>
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=<%= settings.adsense_publisher_id %>" crossorigin="anonymous"></script>
  <% } %>
  <% if (settings.ad_header_code) { %><%- settings.ad_header_code %><% } %>
</head>
<body>
<header class="site-header">
  <div class="container">
    <div class="header-inner">
      <div class="logo">
        <a href="/">
          <% if (settings.site_logo) { %>
            <img src="<%= settings.site_logo %>" alt="<%= settings.site_name %>" class="logo-img">
          <% } else { %>
            <span class="logo-text"><i class="fas fa-heartbeat"></i> <%= settings.site_name || 'GlucoHarbor' %></span>
          <% } %>
        </a>
      </div>
      <nav class="main-nav">
        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation"><i class="fas fa-bars"></i></button>
        <ul class="nav-list" id="navList">
          <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a></li>
          <li class="has-dropdown">
            <a href="/articles" class="<%= currentPath.startsWith('/article') || currentPath.startsWith('/category') ? 'active' : '' %>">Articles <i class="fas fa-chevron-down fa-xs"></i></a>
            <ul class="dropdown">
              <li><a href="/articles">All Articles</a></li>
              <% navCategories.slice(0,8).forEach(function(cat){ %>
              <li><a href="/category/<%= cat.slug %>"><%= cat.name %></a></li>
              <% }); %>
            </ul>
          </li>
          <li><a href="/products" class="<%= currentPath.startsWith('/product') ? 'active' : '' %>">Products</a></li>
        </ul>
      </nav>
      <div class="header-search">
        <form action="/search" method="get" role="search">
          <input type="text" name="q" placeholder="Search..." aria-label="Search">
          <button type="submit" aria-label="Submit search"><i class="fas fa-search"></i></button>
        </form>
      </div>
    </div>
  </div>
</header>
<main class="main-content">
