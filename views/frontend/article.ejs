<%- include('partials/head', {ogImage: article.featured_image}) %>

<article class="article-detail" itemscope itemtype="https://schema.org/Article">
  <!-- Article Header -->
  <div class="article-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">Home</a> <i class="fas fa-chevron-right fa-xs"></i>
        <% if (article.category_name) { %>
        <a href="/articles">Articles</a> <i class="fas fa-chevron-right fa-xs"></i>
        <a href="/category/<%= article.category_slug %>"><%= article.category_name %></a> <i class="fas fa-chevron-right fa-xs"></i>
        <% } else { %>
        <a href="/articles">Articles</a> <i class="fas fa-chevron-right fa-xs"></i>
        <% } %>
        <span><%= article.title.substring(0,50) %>...</span>
      </nav>
      <% if (article.category_name) { %><a href="/category/<%= article.category_slug %>" class="badge badge-lg"><%= article.category_name %></a><% } %>
      <h1 itemprop="headline"><%= article.title %></h1>
      <div class="article-meta">
        <span><i class="fas fa-calendar-alt"></i> <time itemprop="datePublished" datetime="<%= article.published_at %>"><%= dayjs(article.published_at).format('MMMM D, YYYY') %></time></span>
        <% if (article.author_name) { %><span><i class="fas fa-user"></i> <span itemprop="author"><%= article.author_name %></span></span><% } %>
        <span><i class="fas fa-eye"></i> <%= article.views %> views</span>
      </div>
    </div>
  </div>

  <div class="container layout-with-sidebar">
    <div class="content-area">
      <!-- Featured Image -->
      <% if (article.featured_image) { %>
      <figure class="article-featured-img">
        <img src="<%= article.featured_image %>" alt="<%= article.title %>" itemprop="image">
      </figure>
      <% } %>

      <!-- Top Ad -->
      <% if (settings.ad_article_top_code) { %><div class="ad-slot"><%- settings.ad_article_top_code %></div><% } %>

      <!-- Article Content -->
      <div class="article-content" itemprop="articleBody">
        <%- article.content %>
      </div>

      <!-- Bottom Ad -->
      <% if (settings.ad_article_bottom_code) { %><div class="ad-slot"><%- settings.ad_article_bottom_code %></div><% } %>

      <!-- Share -->
      <div class="share-bar">
        <span>Share this article:</span>
        <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(appUrl + '/article/' + article.slug) %>" target="_blank" rel="noopener" class="share-btn share-fb"><i class="fab fa-facebook-f"></i> Facebook</a>
        <a href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(appUrl + '/article/' + article.slug) %>&text=<%= encodeURIComponent(article.title) %>" target="_blank" rel="noopener" class="share-btn share-tw"><i class="fab fa-x-twitter"></i> X</a>
      </div>
    </div>

    <aside class="sidebar">
      <% if (settings.ad_sidebar_code) { %><div class="ad-slot widget"><%- settings.ad_sidebar_code %></div><% } %>
      <div class="widget">
        <h3 class="widget-title">Categories</h3>
        <ul class="widget-list">
          <% categories.forEach(function(cat){ %>
          <li class="<%= article.category_id === cat.id ? 'active' : '' %>">
            <a href="/category/<%= cat.slug %>"><%= cat.name %> <span class="count"><%= cat.article_count %></span></a>
          </li>
          <% }); %>
        </ul>
      </div>
    </aside>
  </div>

  <!-- Related Articles -->
  <% if (related && related.length > 0) { %>
  <section class="related-section">
    <div class="container">
      <h2 class="section-title">Related Articles</h2>
      <div class="article-grid four-col">
        <% related.forEach(function(r){ %>
        <article class="article-card">
          <a href="/article/<%= r.slug %>" class="card-img-link">
            <% if (r.featured_image) { %>
            <img src="<%= r.featured_image %>" alt="<%= r.title %>" loading="lazy">
            <% } else { %>
            <div class="card-img-placeholder"><i class="fas fa-newspaper"></i></div>
            <% } %>
          </a>
          <div class="card-body">
            <h3><a href="/article/<%= r.slug %>"><%= r.title %></a></h3>
            <span class="card-date"><i class="fas fa-calendar-alt"></i> <%= dayjs(r.published_at).format('MMM D, YYYY') %></span>
          </div>
        </article>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>
</article>

<!-- JSON-LD Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "<%= article.title.replace(/"/g, '\\"') %>",
  "description": "<%= (article.excerpt || '').replace(/"/g, '\\"') %>",
  "url": "<%= appUrl %>/article/<%= article.slug %>",
  "datePublished": "<%= article.published_at %>",
  "dateModified": "<%= article.updated_at %>",
  "author": { "@type": "Organization", "name": "<%= settings.site_name || 'GlucoHarbor' %>" },
  "publisher": { "@type": "Organization", "name": "<%= settings.site_name || 'GlucoHarbor' %>", "url": "<%= appUrl %>" }
  <% if (article.featured_image) { %>, "image": "<%= appUrl + article.featured_image %>"<% } %>
}
</script>

<%- include('partials/footer') %>
