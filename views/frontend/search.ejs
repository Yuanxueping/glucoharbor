<%- include('partials/head') %>

<section class="page-banner">
  <div class="container">
    <h1>Search Results</h1>
    <% if (query) { %><p>Found <strong><%= total %></strong> results for "<strong><%= query %></strong>"</p><% } %>
    <form action="/search" method="get" class="search-form-large">
      <input type="text" name="q" value="<%= query %>" placeholder="Search articles...">
      <button type="submit"><i class="fas fa-search"></i> Search</button>
    </form>
  </div>
</section>

<section class="section">
  <div class="container">
    <% if (articles.length === 0) { %>
    <div class="empty-state"><i class="fas fa-search"></i><p>No results found. Try different keywords.</p></div>
    <% } else { %>
    <div class="article-list">
      <% articles.forEach(function(a){ %>
      <article class="article-list-item">
        <% if (a.featured_image) { %>
        <a href="/article/<%= a.slug %>" class="list-img"><img src="<%= a.featured_image %>" alt="<%= a.title %>" loading="lazy"></a>
        <% } %>
        <div class="list-body">
          <% if (a.category_name) { %><a href="/category/<%= a.category_slug %>" class="card-category"><%= a.category_name %></a><% } %>
          <h2><a href="/article/<%= a.slug %>"><%= a.title %></a></h2>
          <% if (a.excerpt) { %><p><%= a.excerpt.substring(0,200) %>...</p><% } %>
          <div class="card-meta">
            <span><i class="fas fa-calendar-alt"></i> <%= dayjs(a.published_at).format('MMM D, YYYY') %></span>
          </div>
        </div>
      </article>
      <% }); %>
    </div>
    <% if (pages > 1) { %>
    <nav class="pagination">
      <% for(let i=1;i<=pages;i++){ %>
      <a href="/search?q=<%= encodeURIComponent(query) %>&page=<%= i %>" class="page-btn <%= i===page?'active':'' %>"><%= i %></a>
      <% } %>
    </nav>
    <% } %>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
