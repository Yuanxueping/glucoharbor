<%- include('partials/head') %>

<!-- Hero Section -->
<% if (featured && featured.length > 0) { %>
<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-main">
        <a href="/article/<%= featured[0].slug %>" class="hero-card">
          <% if (featured[0].featured_image) { %>
          <div class="hero-img" style="background-image:url('<%= featured[0].featured_image %>')"></div>
          <% } else { %>
          <div class="hero-img hero-img-placeholder"></div>
          <% } %>
          <div class="hero-body">
            <% if (featured[0].category_name) { %><span class="badge"><%= featured[0].category_name %></span><% } %>
            <h1 class="hero-title"><%= featured[0].title %></h1>
            <% if (featured[0].excerpt) { %><p class="hero-excerpt"><%= featured[0].excerpt.substring(0,150) %>...</p><% } %>
            <span class="read-more">Read Article <i class="fas fa-arrow-right"></i></span>
          </div>
        </a>
      </div>
      <div class="hero-side">
        <% featured.slice(1,4).forEach(function(a){ %>
        <a href="/article/<%= a.slug %>" class="hero-side-card">
          <% if (a.featured_image) { %>
          <div class="side-img" style="background-image:url('<%= a.featured_image %>')"></div>
          <% } else { %>
          <div class="side-img side-img-placeholder"></div>
          <% } %>
          <div class="side-body">
            <% if (a.category_name) { %><span class="badge badge-sm"><%= a.category_name %></span><% } %>
            <h3><%= a.title %></h3>
          </div>
        </a>
        <% }); %>
      </div>
    </div>
  </div>
</section>
<% } %>

<!-- Categories Bar -->
<section class="categories-bar">
  <div class="container">
    <div class="cat-list">
      <% navCategories.forEach(function(cat){ %>
      <a href="/category/<%= cat.slug %>" class="cat-chip">
        <% if (cat.icon) { %><i class="fas fa-<%= cat.icon %>"></i><% } %>
        <%= cat.name %>
        <% if (cat.article_count > 0) { %><span class="cat-count"><%= cat.article_count %></span><% } %>
      </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- Header Ad Slot -->
<% if (settings.ad_header_code) { %>
<div class="ad-slot container"><%- settings.ad_header_code %></div>
<% } %>

<!-- Recent Articles -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Latest Health Articles</h2>
      <a href="/articles" class="view-all">View All <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="article-grid">
      <% articles.forEach(function(a){ %>
      <article class="article-card">
        <a href="/article/<%= a.slug %>" class="card-img-link">
          <% if (a.featured_image) { %>
          <img src="<%= a.featured_image %>" alt="<%= a.title %>" loading="lazy">
          <% } else { %>
          <div class="card-img-placeholder"><i class="fas fa-newspaper"></i></div>
          <% } %>
        </a>
        <div class="card-body">
          <% if (a.category_name) { %><a href="/category/<%= a.category_slug %>" class="card-category"><%= a.category_name %></a><% } %>
          <h3><a href="/article/<%= a.slug %>"><%= a.title %></a></h3>
          <% if (a.excerpt) { %><p class="card-excerpt"><%= a.excerpt.substring(0,100) %>...</p><% } %>
          <div class="card-meta">
            <span><i class="fas fa-calendar-alt"></i> <%= dayjs(a.published_at).format('MMM D, YYYY') %></span>
            <span><i class="fas fa-eye"></i> <%= a.views %></span>
          </div>
        </div>
      </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- Sidebar Ad -->
<% if (settings.ad_sidebar_code) { %>
<div class="ad-slot container"><%- settings.ad_sidebar_code %></div>
<% } %>

<!-- Products Section -->
<% if (products && products.length > 0) { %>
<section class="section section-alt">
  <div class="container">
    <div class="section-header">
      <h2>Recommended Products</h2>
      <a href="/products" class="view-all">View All <i class="fas fa-arrow-right"></i></a>
    </div>
    <div class="product-grid">
      <% products.forEach(function(p){ %>
      <div class="product-card">
        <a href="/product/<%= p.slug %>" class="product-img-link">
          <% if (p.image) { %>
          <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
          <% } else { %>
          <div class="product-img-placeholder"><i class="fas fa-box-open"></i></div>
          <% } %>
          <% if (p.badge) { %><span class="product-badge"><%= p.badge %></span><% } %>
        </a>
        <div class="product-body">
          <% if (p.category_name) { %><span class="product-category"><%= p.category_name %></span><% } %>
          <h3><a href="/product/<%= p.slug %>"><%= p.name %></a></h3>
          <% if (p.short_desc) { %><p><%= p.short_desc.substring(0,80) %>...</p><% } %>
          <div class="product-price-row">
            <% if (p.price) { %>
            <span class="price"><%= p.currency || '$' %><%= parseFloat(p.price).toFixed(2) %></span>
            <% if (p.original_price) { %><span class="price-original"><%= p.currency || '$' %><%= parseFloat(p.original_price).toFixed(2) %></span><% } %>
            <% } %>
            <% if (p.affiliate_url) { %>
            <a href="<%= p.affiliate_url %>" target="_blank" rel="noopener sponsored" class="btn-buy">Buy Now</a>
            <% } else { %>
            <a href="/product/<%= p.slug %>" class="btn-buy">Details</a>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
