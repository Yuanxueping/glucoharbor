<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc><%= appUrl %>/</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
  <url><loc><%= appUrl %>/articles</loc><changefreq>daily</changefreq><priority>0.8</priority></url>
  <url><loc><%= appUrl %>/products</loc><changefreq>weekly</changefreq><priority>0.7</priority></url>
  <% categories.forEach(function(cat){ %>
  <url><loc><%= appUrl %>/category/<%= cat.slug %></loc><changefreq>daily</changefreq><priority>0.7</priority></url>
  <% }); %>
  <% articles.forEach(function(a){ %>
  <url>
    <loc><%= appUrl %>/article/<%= a.slug %></loc>
    <lastmod><%= new Date(a.updated_at).toISOString().split('T')[0] %></lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  <% }); %>
</urlset>
