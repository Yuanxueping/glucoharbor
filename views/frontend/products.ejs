<%- include('partials/head') %>

<section class="page-banner">
  <div class="container">
    <nav class="breadcrumb"><a href="/">Home</a> <i class="fas fa-chevron-right fa-xs"></i> <span>Products</span></nav>
    <h1>Health & Wellness Products</h1>
    <p>Curated products to support your health journey</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <!-- Category Filter -->
    <% if (categories.length > 0) { %>
    <div class="filter-bar">
      <a href="/products" class="filter-btn <%= !currentCategoryId ? 'active' : '' %>">All</a>
      <% categories.forEach(function(c){ %>
      <a href="/products?category=<%= c.id %>" class="filter-btn <%= currentCategoryId == c.id ? 'active' : '' %>"><%= c.name %></a>
      <% }); %>
    </div>
    <% } %>

    <% if (products.length === 0) { %>
    <div class="empty-state"><i class="fas fa-box-open"></i><p>No products available.</p></div>
    <% } else { %>
    <div class="product-grid">
      <% products.forEach(function(p){ %>
      <div class="product-card">
        <a href="/product/<%= p.slug %>" class="product-img-link">
          <% if (p.image) { %>
          <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
          <% } else { %>
          <div class="product-img-placeholder"><i class="fas fa-box-open"></i></div>
          <% } %>
          <% if (p.badge) { %><span class="product-badge"><%= p.badge %></span><% } %>
        </a>
        <div class="product-body">
          <% if (p.category_name) { %><span class="product-category"><%= p.category_name %></span><% } %>
          <h2><a href="/product/<%= p.slug %>"><%= p.name %></a></h2>
          <% if (p.short_desc) { %><p><%= p.short_desc.substring(0,100) %>...</p><% } %>
          <div class="product-price-row">
            <% if (p.price) { %>
            <span class="price"><%= p.currency || '$' %><%= parseFloat(p.price).toFixed(2) %></span>
            <% if (p.original_price) { %><span class="price-original"><%= p.currency || '$' %><%= parseFloat(p.original_price).toFixed(2) %></span><% } %>
            <% } %>
            <% if (p.affiliate_url) { %>
            <a href="<%= p.affiliate_url %>" target="_blank" rel="noopener sponsored" class="btn-buy">Buy Now <i class="fas fa-external-link-alt fa-xs"></i></a>
            <% } else { %>
            <a href="/product/<%= p.slug %>" class="btn-buy">Learn More</a>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <!-- Pagination -->
    <% if (pages > 1) { %>
    <nav class="pagination">
      <% for(let i=1;i<=pages;i++){ %>
      <a href="/products?page=<%= i %>" class="page-btn <%= i===page?'active':'' %>"><%= i %></a>
      <% } %>
    </nav>
    <% } %>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
