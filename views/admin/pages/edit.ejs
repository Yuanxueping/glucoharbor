<%- include('../partials/head') %>
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet">

<div class="page-title">
  <h1><%= page ? 'Edit Page' : 'New Page' %></h1>
  <a href="/admin/pages" class="btn btn-outline-secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<form method="post" action="<%= page ? '/admin/pages/' + page.id : '/admin/pages' %>" id="pageForm">
  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card-box">
        <div class="mb-3"><label class="form-label fw-bold">Title *</label><input type="text" name="title" class="form-control form-control-lg" value="<%= page ? page.title : '' %>" required></div>
        <div class="mb-3"><label class="form-label">Slug</label><input type="text" name="slug" class="form-control" value="<%= page ? page.slug : '' %>" placeholder="auto-generated"></div>
        <div class="mb-3">
          <label class="form-label fw-bold">Content</label>
          <div id="quillEditor" style="min-height:400px"><%= page ? page.content || '' : '' %></div>
          <input type="hidden" name="content" id="contentInput">
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card-box">
        <h3 class="card-box-title">Settings</h3>
        <div class="mb-3"><label class="form-label">Status</label>
          <select name="status" class="form-select">
            <option value="published" <%= (!page || page.status==='published')?'selected':'' %>>Published</option>
            <option value="draft" <%= (page && page.status==='draft')?'selected':'' %>>Draft</option>
          </select>
        </div>
        <div class="mb-3">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" name="in_footer" value="1" id="inFooter" <%= (!page || page.in_footer)?'checked':'' %>>
            <label class="form-check-label" for="inFooter">Show in Footer Navigation</label>
          </div>
        </div>
        <div class="mb-3"><label class="form-label">Sort Order</label><input type="number" name="sort_order" class="form-control" value="<%= page ? page.sort_order || 0 : 0 %>"></div>
        <hr>
        <div class="mb-3"><label class="form-label">Meta Title</label><input type="text" name="meta_title" class="form-control" value="<%= page ? page.meta_title || '' : '' %>"></div>
        <div class="mb-3"><label class="form-label">Meta Description</label><textarea name="meta_description" class="form-control" rows="3"><%= page ? page.meta_description || '' : '' %></textarea></div>
        <div class="d-grid"><button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Page</button></div>
      </div>
    </div>
  </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<script>
const quill = new Quill('#quillEditor', { theme: 'snow', modules: { toolbar: [[{header:[1,2,3,false]}],['bold','italic','underline'],['link'],['blockquote'],['clean']] } });
document.getElementById('pageForm').addEventListener('submit', function() {
  document.getElementById('contentInput').value = quill.root.innerHTML;
});
</script>

<%- include('../partials/footer') %>
