<%- include('partials/head', {flash: null}) %>

<div class="page-title">
  <h1>Dashboard</h1>
</div>

<!-- Stats -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon bg-blue"><i class="fas fa-newspaper"></i></div>
    <div class="stat-info">
      <h3><%= stats.articleCount %></h3>
      <p>Total Articles</p>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-green"><i class="fas fa-check-circle"></i></div>
    <div class="stat-info">
      <h3><%= stats.publishedCount %></h3>
      <p>Published</p>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-orange"><i class="fas fa-folder"></i></div>
    <div class="stat-info">
      <h3><%= stats.categoryCount %></h3>
      <p>Categories</p>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon bg-purple"><i class="fas fa-box-open"></i></div>
    <div class="stat-info">
      <h3><%= stats.productCount %></h3>
      <p>Products</p>
    </div>
  </div>
</div>

<!-- Quick Actions -->
<div class="row g-3 mb-4">
  <div class="col-12">
    <div class="card-box">
      <h2 class="card-box-title">Quick Actions</h2>
      <div class="quick-actions">
        <a href="/admin/articles/new" class="quick-btn"><i class="fas fa-plus"></i> New Article</a>
        <a href="/admin/categories" class="quick-btn"><i class="fas fa-folder-plus"></i> Manage Categories</a>
        <a href="/admin/products/new" class="quick-btn"><i class="fas fa-box"></i> New Product</a>
        <a href="/admin/pages/new" class="quick-btn"><i class="fas fa-file-plus"></i> New Page</a>
        <a href="/admin/settings" class="quick-btn"><i class="fas fa-cog"></i> Settings</a>
      </div>
    </div>
  </div>
</div>

<!-- Recent Articles -->
<div class="card-box">
  <div class="card-box-header">
    <h2 class="card-box-title">Recent Articles</h2>
    <a href="/admin/articles" class="btn btn-sm btn-outline-primary">View All</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead>
        <tr><th>Title</th><th>Status</th><th>Date</th><th>Views</th><th>Action</th></tr>
      </thead>
      <tbody>
        <% recentArticles.forEach(function(a){ %>
        <tr>
          <td><a href="/admin/articles/<%= a.id %>/edit"><%= a.title.substring(0,60) %><%= a.title.length>60?'...':'' %></a></td>
          <td><span class="badge-status badge-<%= a.status %>"><%= a.status %></span></td>
          <td><%= a.published_at ? new Date(a.published_at).toLocaleDateString() : '-' %></td>
          <td><%= a.views %></td>
          <td><a href="/article/<%= a.slug %>" target="_blank" class="btn btn-xs btn-outline-secondary"><i class="fas fa-eye"></i></a></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<!-- API Info -->
<div class="card-box mt-3">
  <h2 class="card-box-title"><i class="fas fa-plug"></i> API Integration (n8n / DeepSeek)</h2>
  <p class="text-muted">Use the API endpoint to import AI-generated articles from n8n workflows:</p>
  <div class="api-endpoint">
    <code>POST <%= appUrl %>/api/articles/import</code>
    <br><code>Header: x-api-token: [Your API Token from Settings]</code>
    <br><br>
    <strong>Request body example:</strong>
    <pre class="code-block">{
  "title": "Article title",
  "content": "&lt;p&gt;HTML content...&lt;/p&gt;",
  "excerpt": "Brief summary",
  "category_slug": "diabetes-management",
  "featured_image": "https://example.com/image.jpg",
  "status": "published",
  "source": "ai"
}</pre>
  </div>
  <a href="/admin/settings" class="btn btn-sm btn-primary"><i class="fas fa-key"></i> Manage API Token</a>
</div>

<%- include('partials/footer') %>
